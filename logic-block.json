      "type": "array",
      "default": []
    },
    "graphHistoryLimit": {
      "type": "number",
      "default": 5
    },
    "formula": {
      "type": "string",
      "default": ""
    },
    "outputConfigs": {
      "type": "object",
      "default": {}
    }
  },
  "editorScript": "file:./build/index.js",
  "render": "file:./logic-render.php"
}
