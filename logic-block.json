{
  "apiVersion": 3,
  "name": "custom/nodelogic-logic",
  "title": "NodeLogic Graph Builder Logic",
  "category": "advanced-blocks-calculator",
  "icon": "networking",
  "description": "Node-based logic graph that controls multiple HTML elements on the page.",
  "attributes": {
    "editorId": {
      "type": "string"
    },
    "graphState": {
      "type": "object",
