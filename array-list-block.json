{
  "apiVersion": 3,
  "name": "custom/nodelogic-array-list",
  "title": "Array List",
  "category": "advanced-blocks-calculator",
  "icon": "editor-ul",
  "description": "Display arrays as a responsive grid list.",
  "attributes": {
    "listId": { "type": "string" },
    "rows": {
      "type": "number",
      "default": 3
    },
    "columns": {
      "type": "number",
      "default": 2
    },
    "listHeight": {
      "type": "number",
      "default": 0
    },
    "emptyText": {
      "type": "string",
      "default": "Array output will appear here."
    },
    "padding": { "type": "number", "default": 12 },
    "paddingTop": { "type": "number", "default": 12 },
    "paddingRight": { "type": "number", "default": 12 },
    "paddingBottom": { "type": "number", "default": 12 },
    "paddingLeft": { "type": "number", "default": 12 },
    "margin": { "type": "number", "default": 0 },
    "marginTop": { "type": "number", "default": 0 },
    "marginRight": { "type": "number", "default": 0 },
    "marginBottom": { "type": "number", "default": 14 },
    "marginLeft": { "type": "number", "default": 0 },
    "backgroundEnabled": { "type": "boolean", "default": false },
    "backgroundMode": { "type": "string", "default": "default" },
    "backgroundColor": { "type": "string", "default": "" },
    "borderWidth": { "type": "number", "default": 0 },
    "borderStyle": { "type": "string", "default": "solid" },
    "borderColor": { "type": "string", "default": "" },
    "borderRadius": { "type": "number", "default": 0 },
    "width": { "type": "string", "default": "" },
    "height": { "type": "string", "default": "" },
    "minHeight": { "type": "string", "default": "" }
  },
  "editorScript": "file:./build/index.js"
}
